# Ruta al directorio de la base de conocimiento Prolog (.pl)
# Si se deja vacia, se resuelve automaticamente a ../prolog
# PROLOG_DIR=

# Ruta al archivo de historial JSON
# Si se deja vacia, se resuelve a app/data/historial.json
# HISTORIAL_PATH=

# (Fase 2) Token del bot de Telegram - deuda tecnica
# TELEGRAM_BOT_TOKEN=
