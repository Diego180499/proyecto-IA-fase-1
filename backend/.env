# ============================================================
# Doctor Byte - Variables de entorno del backend
# ============================================================

# Ruta al directorio de la base de conocimiento Prolog (.pl)
# Si se deja vacia, se resuelve automaticamente a ../prolog
# PROLOG_DIR=

# Ruta al archivo de historial JSON
# Si se deja vacia, se resuelve a app/data/historial.json
# HISTORIAL_PATH=

# Token del bot de Telegram.
# Obtenerlo creando un bot con @BotFather en Telegram.
# Formato: 123456789:AABBccDDeeFFggHH...
# IMPORTANTE: El usuario debe enviar /start al bot antes de poder recibir mensajes.
TELEGRAM_BOT_TOKEN=8558767368:AAF5bLgLNgofiR9gyL2ogAAJ26fCuwnkjsY

# Chat ID por defecto al que se enviaran los mensajes.
# Puede ser un usuario, un grupo o un canal (los grupos/canales usan IDs negativos).
TELEGRAM_CHAT_ID=-1003925395185
